{
  "name": "@alcspower/ui",
  "version": "1.6.5",
  "description": "Accessible, composable, and production-ready React 19 component library powered by Tailwind CSS v4 and Radix UI",
  "author": "Alcides Altamirano (AlcsPower)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlcsPower/alcs-ui.git"
  },
  "homepage": "https://github.com/AlcsPower/alcs-ui#readme",
  "bugs": {
    "url": "https://github.com/AlcsPower/alcs-ui/issues"
  },
  "keywords": [
    "react",
    "react-19",
    "components",
    "design-system",
    "alcspower",
    "radix-ui",
    "tailwindcss",
    "tailwind-v4",
    "typescript",
    "ui-library",
    "accessible",
    "wcag",
    "wai-aria",
    "cva"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/styles.css"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "alcspower-ui": "bin/cli.js"
  },
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts",
        "default": "./dist/index.d.ts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./registry.json": "./registry.json",
    "./llms.txt": "./llms.txt",
    "./llms-small.txt": "./llms-small.txt",
    "./snippets": "./snippets/alcspower.code-snippets",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "snippets",
    ".cursor",
    ".github",
    ".agent",
    "CLAUDE.md",
    "AGENTS.md",
    "registry.json",
    "llms.txt",
    "llms-small.txt",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "pnpm build:js && pnpm build:css",
    "build:js": "tsup && node ./scripts/ensure-use-client.js",
    "build:css": "tailwindcss -i ./src/styles/index.css -o ./dist/styles.css --minify",
    "cli": "node ./bin/cli.js",
    "init-agent": "node ./bin/cli.js init-agent",
    "test": "vitest run",
    "test:smoke": "node ./scripts/smoke-test-consumer.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o dist-storybook",
    "changeset": "changeset"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.24",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.16.0",
    "react-day-picker": "^10.0.2",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.12",
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@tailwindcss/cli": "^4.0.9",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^8.6.18",
    "tailwindcss": "^4.0.9",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.11",
    "vitest-axe": "^0.1.0"
  }
}
